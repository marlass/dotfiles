tap "1password/tap"
tap "docker/tap"

# Formulae (CLI)
brew "dockutil"
brew "starship"
brew "fzf"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "zsh-completions"
brew "gh"

# Casks (GUI apps)
# sbx: Docker Sandboxes CLI (AI-agent sandboxing); needs `brew trust --tap docker/tap`,
# handled in run_onchange_after_10-install-packages.sh.tmpl
cask "sbx"
cask "1password"
cask "1password-cli"
cask "raycast"
cask "google-chrome"
cask "spotify"
cask "zed"
# claude-code: managed via native installer on the `latest` channel
# (the cask tracks `stable`, which lags). Install: curl -fsSL https://claude.ai/install.sh | bash -s latest
cask "codex"
cask "codex-app"
cask "roam-research"
cask "wispr-flow"
cask "docker-desktop"
cask "font-jetbrains-mono-nerd-font"

{{ if eq .profile "personal" -}}
cask "signal"
{{- end }}
{{ if eq .profile "work" -}}
brew "kustomize"
brew "sops"
cask "slack"
cask "linear"
cask "tuple"
cask "tailscale-app"
cask "gcloud-cli"
{{- end }}
